// Repaired PydanticAI boundary: model-shaped path is validated before egress.
struct ToolCall:
    path: String
    content: String

fn export_case_file(path: String @path_safe, content: String @user_input) -> Result[Int, String] [io]:
    return write_file(path: path, content: content)

fn dispatch(tool_json: String) -> Int [io]:
    match json_extract[ToolCall](text: tool_json):
        Result.ok(call):
            let safe_path = escape_path(raw: call.path)
            let _ = export_case_file(path: safe_path, content: call.content)
            return 0
        Result.error(message):
            print(value: message)
            return 1

fn main() -> Int [io]:
    return dispatch(tool_json: "{\"path\":\"/tmp/heat_pydanticai_public_case.txt\",\"content\":\"customer_id=4142\"}")
