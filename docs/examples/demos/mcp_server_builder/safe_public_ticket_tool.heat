// MCP server builder V1: safe public tool response.
//
// The tool redacts the sensitive field before returning to a @public
// output contract. Build with --emit-audit-manifest to get the manifest's
// tool_output_contracts entry.

struct PublicTicketContext:
    ticket_id: String
    customer_email: String
    summary: String

fn get_ticket_context(email: String @pii) -> Result[PublicTicketContext, String] [net, db] returns @public:
    let safe = PublicTicketContext(
        ticket_id: "TCK-1024",
        customer_email: redact_pii(value: email),
        summary: "Password reset requested",
    )
    return Result.ok(value: safe)

fn main() -> Int:
    return 0
