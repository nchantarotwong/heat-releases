// Secret -> log calibration.
//
// Expected: error[NL-OBL-001]. This is the easy comparison case: generic
// analyzers usually catch secret-to-log, and Heat refuses the same disclosure
// through the exact same policy used for network egress. @secret is now a
// built-in source tag; secret_env is the deployment-secret boundary.

obligation NoSecretDisclosure:
    "Secrets must never reach external disclosure sinks."
    repair "send only a digest, a capability handle, or a service-local token"
    forbid @secret -> @audit_safe

fn read_deploy_secret() -> String @secret [env]:
    return secret_env(key: "DEPLOY_SECRET")

fn audit_startup() -> Int [io, env]:
    let secret_value = read_deploy_secret()
    return log_info(message: secret_value)

fn main() -> Int [io, env]:
    return audit_startup()
