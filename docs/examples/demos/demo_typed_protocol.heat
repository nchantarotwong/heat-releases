// FileWriter declares a protocol: you must open() before you can write().
// This caller writes first. It's not a data race, so no other language's
// type system catches it — it fails at runtime as a dropped message or a
// wrong-state reply. Heat tracks the handle's protocol state and refuses
// the out-of-order send at compile time — NL-PROTO-1.
actor FileWriter:
    var n: Int = 0
    protocol:
        state Closed:
            open(path: String) -> Opened
        state Opened:
            write(data: String) -> Opened
            close() -> Closed
        initial: Closed

    receive open(path: String) -> Int:
        n = 0
        return n

    receive write(data: String) -> Int:
        n = n + 1
        return n

    receive close() -> Int:
        n = 0
        return n

fn main() -> Int [io]:
    let f = spawn FileWriter()
    return await f.write(data: "hello")
