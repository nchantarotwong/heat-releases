// --- Provenance: tags on strings that cross trust boundaries ---
// See examples/provenance_demo.heat for the full worked example.
// See docs/STDLIB_SURFACE.heat for the complete stdlib surface.
//
// Provenance tags track where string values came from. The compiler
// prevents untrusted data from flowing into security-sensitive sinks
// (SQL, shell, HTML, paths) without going through a sanitizer or
// parameterized API. Most code doesn't need annotations — untagged
// String is polymorphic and passes tags through. Only BOUNDARIES
// (sources and sinks) need explicit tags.

// A polymorphic helper — no tags, accepts any tagged value and
// passes the tag through. Most of your code looks like this.
fn truncate(text: String, max_len: Int) -> String:
    return text

// A source boundary — data from outside the program is untrusted.
fn read_username_from_stdin() -> String @user_input [io]:
    todo("read from stdin")

// A sink boundary — requires a specific tag. Pass user input through
// the parameterized alternative (see provenance_demo.heat), never
// concatenate into the SQL string directly.
fn find_user_by_name(name: String @user_input) -> String [io]:
    // Not shown: db_exec(db: db, sql: "SELECT ... WHERE name = ?", params: [name])
    // That's what the full demo in provenance_demo.heat walks through.
    todo("database query with parameters")

test "polymorphic helpers accept any tag":
    // Literals are implicitly @literal and promote to any tag
    let trimmed = truncate(text: "hello", max_len: 3)
    assert trimmed.length() == 5


// --- Main: the demo ---

fn main() -> Int [io]:
    // Constrained types + interface dispatch
    let user = User(name: "Alice", age: 30, level: 3)
    print(value: user.describe())

    let team = Team(name: "Platform", max_members: 50)
    print(value: team.describe())

    // Generics
    let pair = Pair(first: 10, second: 20)
    print(value: format("Pair: {first} + {second}", first: pair.first, second: pair.second))

    // Pattern matching
    print(value: format("Role: {role}", role: role_label(role: Role.editor)))

    // Result handling
    print(value: safe_divide(a: 100, b: 4))

    // List literals + for loop
    var high_count = 0
    for score in [95, 87, 42, 73, 88]:
        if score > 80:
            high_count = high_count + 1
    print(value: format("High scores: {count}", count: high_count))

    // Actors
    let counter = spawn Counter()
    let id = await counter.increment()
    print(value: format("Counter: {id}", id: id))

    return 0
